# Copy to .env for local runs. Placeholders only — no real keys.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3-flash
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Reserved for the server-side STT upgrade path (unused in v1).
FIREWORKS_STT_MODEL=whisper-v3-turbo
# 1 = stubbed LLM (default, works offline); 0 = call Fireworks (needs key above).
MOCK_LLM=1
PORT=8000
# Shareable demo (scripts/share.sh sets these): 1 = replay-only public demo —
# only the fictional demo session(s) are served, every write to recordings/
# is blocked (403), unknown session ids 404. New interviews stay local.
DEMO_MODE=0
# Fictional demo sessions served in DEMO_MODE (+ any "demo-" session id),
# demo reconstruction login shown on screen, startup seeding toggle.
DEMO_SESSIONS=demo-synthetic,demo-resumed
DEMO_CHARACTER_NAME=demo-guest
DEMO_INVITE_CODE=demo-invite-1958
DEMO_SEED=1
# App-side rate limits on LLM-backed routes only (/api/turn, /api/ask,
# /api/character); static pages and clip replay are unlimited.
# Per-IP sliding window: RATE_LIMIT_PER_IP_MAX requests per
# RATE_LIMIT_PER_IP_WINDOW_S seconds; plus a global UTC-day cap.
# Client identity honors CF-Connecting-IP (tunnel collapses to 127.0.0.1).
RATE_LIMIT_PER_IP_MAX=120
RATE_LIMIT_PER_IP_WINDOW_S=3600
RATE_LIMIT_GLOBAL_DAY_MAX=2000
